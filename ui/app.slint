import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";
import { MapTile, MapPage, NearbyPin } from "pages/map_page.slint";
import { StreamPage } from "pages/stream_page.slint";
import { MediaRow, MediaPage } from "pages/media_page.slint";
import { DeviceRow } from "pages/devices/device_list.slint";
import { ProfilePage } from "pages/profile/profile_page.slint";
import { TopBar } from "shell/top_bar.slint";

export component AppWindow inherits Window {
    // Left empty: on macOS the menu bar's app name is derived from the
    // bundle info (independent of this property), so setting a title here
    // just duplicates "Third Eye Client" a second time in the title bar.
    title: "";
    icon: @image-url("../assets/logo.png");
    preferred-width: 1520px;
    preferred-height: 960px;
    min-width: 680px;
    min-height: 400px;

    in-out property <int> active_screen: 0;
    // Read-only mirror of content_panel's actual laid-out size, polled from
    // Rust at startup to kick off an initial navigate_map() call when
    // Device Map is the default screen (see fn main()'s timer). A `changed`
    // callback on content_panel's width doesn't work for this: it only
    // fires on subsequent changes, not for the first layout pass's value.
    out property <length> content_panel_width: content_panel.width;
    out property <length> content_panel_height: content_panel.height;

    in-out property <string> rtsp_url;
    in-out property <string> rov_http_base;
    in-out property <string> rov_status_udp_port;
    in-out property <string> osm_tile_user_agent;
    in-out property <bool> use_saved_map_tiles: false;
    in-out property <string> max_tile_storage_mb: "1024";
    in-out property <string> tile_cache_size_text;
    in-out property <string> rov_info;
    in-out property <string> local_network_info;

    // Phone GPS (NMEA/TAIP — auto-detects Bluetooth or TCP).
    in-out property <string> nmea_gps_port;
    in-out property <string> nmea_gps_status;
    in-out property <bool> nmea_gps_running: false;
    in-out property <bool> nmea_has_fix: false;
    in-out property <string> nmea_local_ip;
    in property <[string]> nmea_serial_port_options;
    in-out property <int> nmea_serial_port_index: -1;
    in-out property <string> nmea_serial_ports;
    // 0 = Auto (BT / TCP listen), 1 = Connect to Server (TCP client).
    in-out property <int> nmea_gps_mode: 0;
    // 0 = NMEA, 1 = TAIP.
    in-out property <int> nmea_gps_protocol: 0;
    in-out property <string> nmea_serial_port;
    in-out property <string> nmea_server_host;
    in-out property <string> nmea_server_port;
    in-out property <string> nmea_stale_timeout: "10";

    // Stream status for the overlay.
    in-out property <bool> stream_is_active: false;
    in-out property <bool> rov_listener_running: false;

    // Server account (third-eye backend).
    in-out property <string> server_base_url;
    in-out property <string> auth_email;
    in-out property <string> auth_password;
    in-out property <string> auth_status_text;
    in-out property <string> auth_signed_in_as;
    in-out property <bool> auth_is_signed_in: false;
    // Precomputed on the Rust side (e.g. first letter of the signed-in
    // email); used by the Profile nav item's and Profile page's avatar.
    in-out property <string> auth_avatar_text: "?";
    in-out property <string> app_version;
    in-out property <string> running_build_info;
    in-out property <string> update_status_text;
    in-out property <string> update_latest_version;
    in-out property <bool> update_available: false;
    in-out property <bool> update_check_in_progress: false;

    // Per-capture ROV telemetry summary surfaced after a successful capture.
    in-out property <string> attached_metadata_text;

    // Devices bindings (List+Detail over device_handler_api), surfaced
    // under the Profile page rather than as a top-level workspace screen.
    in property <[DeviceRow]> device_rows;
    in-out property <string> devices_status;
    in-out property <bool> device_action_in_progress: false;
    // Id of the locally-persisted active device (see storage::devices::DeviceCacheStore).
    // Drives Device Map / Live Stream RTSP settings and keeps working offshore
    // with no internet access to the third-eye server.
    in-out property <string> device_active_id;
    // Display name of the active device (empty when none is set). Shown as
    // a badge on the Live Stream page.
    in-out property <string> active_device_name;
    in-out property <string> device_selected_id;
    in-out property <string> device_selected_category;
    in-out property <string> device_selected_type;
    in-out property <string> device_selected_created_text;
    in-out property <string> device_selected_updated_text;
    in-out property <string> device_name_draft;
    in-out property <string> new_device_name;
    // Editable draft of the selected (or new) device's ChasingM2SConfiguration,
    // flattened into individual string fields (see storage/DeviceConfigDraft
    // in main.rs). Applies in both create and edit modes, since a new
    // device's configuration is seeded from these same fields.
    in-out property <string> device_cfg_host;
    in-out property <string> device_cfg_rtsp_username;
    in-out property <string> device_cfg_rtsp_password;
    in-out property <string> device_cfg_rtsp_transport;
    in-out property <string> device_cfg_rtsp_reconnect_backoff_ms;
    in-out property <string> device_cfg_rtsp_port;
    in-out property <string> device_cfg_rtsp_channel;
    in-out property <string> device_cfg_rtsp_profile;
    in-out property <string> device_cfg_udp_port;
    in-out property <string> device_cfg_udp_expected_id;
    in-out property <string> device_cfg_udp_expected_type;
    in-out property <string> device_cfg_http_connect_timeout_ms;
    in-out property <string> device_cfg_http_request_timeout_ms;
    in-out property <string> device_cfg_http_port;
    in-out property <string> device_cfg_capture_burst;
    in-out property <string> device_cfg_capture_format;

    // Media screen bindings.
    in property <[MediaRow]> media_rows;
    in-out property <string> media_status;
    in-out property <string> media_selected_id;
    in-out property <string> media_selected_name;
    in-out property <string> media_selected_details;
    in-out property <string> media_selected_capture_text;
    in-out property <string> media_selected_local_path;
    in-out property <bool> media_selected_has_capture_meta: false;
    in-out property <bool> media_download_in_progress: false;
    in-out property <bool> media_selected_deleted_on_rov: false;
    in-out property <image> media_preview_image;
    in-out property <bool> has_media_preview: false;
    in-out property <bool> media_selected_is_video: false;
    in-out property <bool> media_stream_active: false;

    // Structured capture telemetry for media detail overlay.
    in-out property <string> media_capture_depth;
    in-out property <string> media_capture_temp;
    in-out property <string> media_capture_heading;
    in-out property <string> media_capture_attitude;
    in-out property <string> media_capture_coords;
    in-out property <string> media_capture_battery;
    // Compact subtitle: "793 KB \u{2022} image/jpeg \u{2022} 1920\u{00d7}1080"
    in-out property <string> media_info_subtitle;
    // Formatted capture date/time for the selected media (empty if no metadata).
    in-out property <string> media_capture_datetime;
    // True when the selected media is an image (not a video).
    in-out property <bool> media_selected_is_image: false;

    in-out property <string> map_status;
    in-out property <string> corelocation_debug;
    in-out property <string> lat_lon_text;
    in-out property <string> zoom_text;
    in property <[MapTile]> map_tiles;
    // Live "what's around you" overlay for Device Map (AOI/POI/Intermagnet
    // analysis pins pulled from `/api/v1/search`).
    in property <[NearbyPin]> nearby_pins;
    in-out property <length> map_pin_world_x: 0px;
    in-out property <length> map_pin_world_y: 0px;
    in-out property <bool> map_has_pin: false;
    in-out property <length> map_viewport_x: 0px;
    in-out property <length> map_viewport_y: 0px;
    in-out property <length> map_viewport_width: 0px;
    in-out property <length> map_viewport_height: 0px;
    in-out property <string> pin_lat_lon_short;
    in property <length> scale_bar_width: 100px;
    in-out property <string> scale_bar_text;

    in-out property <string> stream_status;
    in-out property <string> frames_received_text;
    in-out property <image> stream_image;
    in-out property <bool> has_stream_image: false;

    in-out property <string> rov_status_text;
    in-out property <string> rov_packets_received_text;
    in-out property <bool> has_rov_status: false;
    in-out property <string> rov_attitude_text;
    in-out property <string> rov_depth_temp_text;
    in-out property <string> rov_coordinates_text;
    in-out property <string> rov_imu_text;
    in-out property <string> rov_batteries_text;

    // Compact overlay telemetry for the full-bleed stream screen.
    in-out property <string> rov_depth_short;
    in-out property <string> rov_temp_short;
    in-out property <string> rov_heading_short;
    in-out property <string> rov_attitude_short;
    in-out property <string> rov_coords_short;
    in-out property <string> rov_battery_short;

    callback navigate_profile();
    callback navigate_map(length, length);
    callback navigate_stream();
    callback navigate_media();
    callback navigate_nmea();

    callback refresh_devices();
    callback select_device(string);
    callback create_device(string);
    callback save_device_name(string, string);
    callback delete_device(string);
    callback set_active_device(string);
    callback go_live_with_device(string);

    callback use_default_test_rtsp();
    callback use_default_rov_rtsp();
    callback use_default_rov_http_base();
    callback use_host_from_rov_http_base();
    callback use_default_rov_status_udp_port();
    callback use_default_osm_tile_user_agent();
    callback recalibrate_rov_network();

    callback list_medias();
    callback capture_photo();

    callback refresh_media();
    callback open_local_media_folder();
    callback select_media(string, string);
    callback download_selected_media();
    callback open_selected_local_media();
    callback delete_selected_media_from_rov();
    callback stream_selected_media();
    callback stop_media_stream();
    callback open_with_telemetry();

    callback start_nmea_gps();
    callback stop_nmea_gps();
    callback prepare_bluetooth();
    callback select_nmea_serial_port(string);
    callback set_nmea_gps_mode(int);
    callback set_nmea_gps_protocol(int);
    in-out property <bool> bt_prepared: false;

    callback sign_in();
    callback sign_out();
    callback use_default_server_base_url();
    callback check_for_updates();
    callback download_update();

    callback detect_location(length, length);
    callback load_map_tile(length, length);
    callback open_interactive_map();
    callback map_flicked(length, length, length, length);
    callback map_zoom_in(length, length, length, length);
    callback map_zoom_out(length, length, length, length);
    // Mouse-wheel / trackpad / touchscreen scroll zoom. Args:
    // (delta_y, viewport_x, viewport_y, canvas_width, canvas_height).
    // Positive delta_y zooms in, negative zooms out; the Rust side rate-limits
    // so one scroll/gesture advances at most one zoom level.
    callback map_scroll_zoom(length, length, length, length, length);
    // Pinch gesture zoom. `scale` is cumulative from gesture start
    // (1.0 = unchanged, >1 zoom in, <1 zoom out).
    callback map_pinch_zoom_start();
    callback map_pinch_zoom_update(float, length, length, length, length, length, length);
    callback map_pinch_zoom_end();
    callback center_map_on_pin(length, length, length, length);

    callback start_stream();
    callback stop_stream();
    callback start_rov_status_listener();
    callback stop_rov_status_listener();

    public function set_map_viewport(ox: length, oy: length, width: length, height: length) {
        root.map_viewport_x = ox;
        root.map_viewport_y = oy;
        root.map_viewport_width = width;
        root.map_viewport_height = height;
    }

    // Absolute positioning rather than a VerticalBox so the full-bleed Device
    // Map can run edge to edge with the top bar floating over it; every other
    // screen starts below the bar as before. content_panel is declared first so
    // the bar paints on top of it.
    //
    // No permanent sidebar (grid-menu popup instead) and no native OS menu bar
    // (previously File/View/Help): every action either menu exposed is reachable
    // from this shell instead — navigation via the grid-menu popup, RTSP/ROV/app
    // settings under Profile's Settings tab, and the rest via in-page buttons.
    Rectangle {
        content_panel := Rectangle {
            x: 0;
            y: root.active_screen == 0 ? 0px : top_bar.height;
            width: parent.width;
            height: parent.height - self.y;
            background: #202328;

            // Phone GPS screen
            if root.active_screen == 3 : ScrollView {
                viewport-width: self.visible-width;

                VerticalBox {
                    padding: 14px;
                    spacing: 10px;

                if root.active_screen == 3 : VerticalBox {
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: "Phone GPS";
                        font-size: 24px;
                    }
                    Text {
                        text: "Receive GPS data from a phone app via Bluetooth, TCP listen, or by connecting to a server.";
                        wrap: word-wrap;
                    }

                    // --- Protocol selector ---
                    Text { text: "GPS protocol:"; font-size: 13px; color: #8f96a3; }
                    HorizontalBox {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            border-width: root.nmea_gps_protocol == 0 ? 2px : 1px;
                            border-color: root.nmea_gps_protocol == 0 ? #0a84ff : #3f4148;
                            background: root.nmea_gps_protocol == 0 ? #0a84ff18 : #1a1c22;
                            Text {
                                text: "NMEA";
                                font-size: 13px;
                                color: root.nmea_gps_protocol == 0 ? #ffffff : #8f96a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.set_nmea_gps_protocol(0); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            border-width: root.nmea_gps_protocol == 1 ? 2px : 1px;
                            border-color: root.nmea_gps_protocol == 1 ? #0a84ff : #3f4148;
                            background: root.nmea_gps_protocol == 1 ? #0a84ff18 : #1a1c22;
                            Text {
                                text: "TAIP";
                                font-size: 13px;
                                color: root.nmea_gps_protocol == 1 ? #ffffff : #8f96a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.set_nmea_gps_protocol(1); }
                            }
                        }
                    }

                    // --- Connection mode selector ---
                    Text { text: "Connection mode:"; font-size: 13px; color: #8f96a3; }
                    HorizontalBox {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            border-width: root.nmea_gps_mode == 0 ? 2px : 1px;
                            border-color: root.nmea_gps_mode == 0 ? #0a84ff : #3f4148;
                            background: root.nmea_gps_mode == 0 ? #0a84ff18 : #1a1c22;
                            Text {
                                text: "TCP Listen";
                                font-size: 13px;
                                color: root.nmea_gps_mode == 0 ? #ffffff : #8f96a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.set_nmea_gps_mode(0); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            border-width: root.nmea_gps_mode == 1 ? 2px : 1px;
                            border-color: root.nmea_gps_mode == 1 ? #0a84ff : #3f4148;
                            background: root.nmea_gps_mode == 1 ? #0a84ff18 : #1a1c22;
                            Text {
                                text: "Connect to TCP Server";
                                font-size: 13px;
                                color: root.nmea_gps_mode == 1 ? #ffffff : #8f96a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.set_nmea_gps_mode(1); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            border-width: root.nmea_gps_mode == 2 ? 2px : 1px;
                            border-color: root.nmea_gps_mode == 2 ? #0a84ff : #3f4148;
                            background: root.nmea_gps_mode == 2 ? #0a84ff18 : #1a1c22;
                            Text {
                                text: "Bluetooth";
                                font-size: 13px;
                                color: root.nmea_gps_mode == 2 ? #ffffff : #8f96a3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.set_nmea_gps_mode(2); }
                            }
                        }
                    }

                    // --- TCP Listen mode fields ---
                    if root.nmea_gps_mode == 0 : VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "The laptop listens for incoming NMEA connections from a phone GPS app (e.g. GPS2IP, GPSd Forwarder). Configure the app to connect to the address and port shown below.";
                            wrap: word-wrap;
                            color: #8f96a3;
                            font-size: 12px;
                        }
                        Text { text: "TCP listen address (auto-detected, editable):"; }
                        LineEdit {
                            text <=> root.nmea_local_ip;
                            placeholder-text: "e.g. 192.168.43.5";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                        Text { text: "TCP listen port:"; }
                        LineEdit {
                            text <=> root.nmea_gps_port;
                            placeholder-text: "e.g. 11123";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                    }

                    // --- Connect to Server mode fields ---
                    if root.nmea_gps_mode == 1 : VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "Connect to a device running an NMEA server app (e.g. Android app like GPS Tether Server, ShareGPS). The laptop connects as a TCP client to the phone's IP and port.";
                            wrap: word-wrap;
                            color: #8f96a3;
                            font-size: 12px;
                        }
                        Text { text: "Phone server IP address:"; }
                        LineEdit {
                            text <=> root.nmea_server_host;
                            placeholder-text: "e.g. 192.168.43.1";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                        Text { text: "Phone server port:"; }
                        LineEdit {
                            text <=> root.nmea_server_port;
                            placeholder-text: "e.g. 8080";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                    }

                    // --- Bluetooth mode fields ---
                    if root.nmea_gps_mode == 2 : VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "Connects to a GPS device via serial port (Bluetooth SPP or USB serial). The selected COM/serial port must be visible to the OS.";
                            wrap: word-wrap;
                            color: #8f96a3;
                            font-size: 12px;
                        }
                        Text { text: "Detected serial ports (Bluetooth/USB):"; }
                        ComboBox {
                            model: root.nmea_serial_port_options;
                            current-index <=> root.nmea_serial_port_index;
                            enabled: root.nmea_serial_port_options.length > 0;
                            height: 36px;
                            vertical-stretch: 0;
                            selected(current-value) => {
                                root.nmea_serial_port = current-value;
                                root.select_nmea_serial_port(current-value);
                            }
                        }
                        Text { text: "Manual serial-port override (optional):"; }
                        LineEdit {
                            text <=> root.nmea_serial_port;
                            placeholder-text: "COM7";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                        if root.nmea_serial_ports != "" : Text {
                            text: "Detected serial ports (Bluetooth/USB): " + root.nmea_serial_ports + " (device must be powered on to connect)";
                            wrap: word-wrap;
                        }
                        if root.nmea_serial_ports == "" : Text {
                            text: "No serial ports detected. Pair Bluetooth first or attach GPS via USB.";
                            wrap: word-wrap;
                            color: #ff6666;
                            font-size: 12px;
                        }
                    }

                    // --- Stale timeout ---
                    VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "Stale fix timeout (minutes):";
                        }
                        LineEdit {
                            text <=> root.nmea_stale_timeout;
                            placeholder-text: "10";
                            height: 36px;
                            vertical-stretch: 0;
                        }
                    }

                    // --- Prepare / Start / Stop ---
                    if root.nmea_gps_mode == 2 : HorizontalBox {
                        spacing: 8px;
                        Button {
                            horizontal-stretch: 1;
                            text: "Prepare Bluetooth";
                            enabled: !root.nmea_gps_running;
                            clicked => {
                                root.prepare_bluetooth();
                                root.bt_prepared = true;
                            }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: "Start GPS";
                            enabled: !root.nmea_gps_running && root.bt_prepared;
                            clicked => { root.start_nmea_gps(); }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: "Stop";
                            enabled: root.nmea_gps_running;
                            clicked => {
                                root.stop_nmea_gps();
                                root.bt_prepared = false;
                            }
                        }
                    }
                    if root.nmea_gps_mode != 2 : HorizontalBox {
                        spacing: 8px;
                        Button {
                            horizontal-stretch: 1;
                            text: "Start Phone GPS";
                            enabled: !root.nmea_gps_running;
                            clicked => { root.start_nmea_gps(); }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: "Stop Phone GPS";
                            enabled: root.nmea_gps_running;
                            clicked => { root.stop_nmea_gps(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: root.nmea_gps_running
                                ? (root.nmea_has_fix ? "OK" : "..")
                                : "--";
                            color: root.nmea_gps_running
                                ? (root.nmea_has_fix ? #22cc44 : #ffaa00)
                                : #ff4444;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.nmea_gps_status;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }

                }
            }

            // Profile screen: account, Devices List+Detail, and (folded in
            // now that there's no native menu bar) the Settings tab that
            // used to be its own top-level Configuration screen.
            if root.active_screen == 4 : ProfilePage {
                auth_is_signed_in: root.auth_is_signed_in;
                auth_signed_in_as: root.auth_signed_in_as;
                auth_status_text: root.auth_status_text;
                auth_avatar_text: root.auth_avatar_text;
                auth_email <=> root.auth_email;
                auth_password <=> root.auth_password;
                sign_in => { root.sign_in(); }
                sign_out => { root.sign_out(); }
                rtsp_url <=> root.rtsp_url;
                rov_http_base <=> root.rov_http_base;
                rov_status_udp_port <=> root.rov_status_udp_port;
                osm_tile_user_agent <=> root.osm_tile_user_agent;
                use_saved_map_tiles <=> root.use_saved_map_tiles;
                max_tile_storage_mb <=> root.max_tile_storage_mb;
                tile_cache_size_text: root.tile_cache_size_text;
                rov_info: root.rov_info;
                local_network_info: root.local_network_info;
                server_base_url <=> root.server_base_url;
                app_version: root.app_version;
                running_build_info: root.running_build_info;
                update_status_text: root.update_status_text;
                update_latest_version: root.update_latest_version;
                update_available: root.update_available;
                update_check_in_progress: root.update_check_in_progress;
                use_default_test_rtsp => { root.use_default_test_rtsp(); }
                use_default_rov_rtsp => { root.use_default_rov_rtsp(); }
                use_default_rov_http_base => { root.use_default_rov_http_base(); }
                use_host_from_rov_http_base => { root.use_host_from_rov_http_base(); }
                use_default_rov_status_udp_port => { root.use_default_rov_status_udp_port(); }
                use_default_osm_tile_user_agent => { root.use_default_osm_tile_user_agent(); }
                use_default_server_base_url => { root.use_default_server_base_url(); }
                check_for_updates => { root.check_for_updates(); }
                download_update => { root.download_update(); }
                recalibrate_rov_network => { root.recalibrate_rov_network(); }
                device_rows: root.device_rows;
                devices_status: root.devices_status;
                device_action_in_progress: root.device_action_in_progress;
                device_active_id: root.device_active_id;
                device_selected_id: root.device_selected_id;
                device_selected_category: root.device_selected_category;
                device_selected_type: root.device_selected_type;
                device_selected_created_text: root.device_selected_created_text;
                device_selected_updated_text: root.device_selected_updated_text;
                device_name_draft <=> root.device_name_draft;
                new_device_name <=> root.new_device_name;
                device_cfg_host <=> root.device_cfg_host;
                device_cfg_rtsp_username <=> root.device_cfg_rtsp_username;
                device_cfg_rtsp_password <=> root.device_cfg_rtsp_password;
                device_cfg_rtsp_transport <=> root.device_cfg_rtsp_transport;
                device_cfg_rtsp_reconnect_backoff_ms <=> root.device_cfg_rtsp_reconnect_backoff_ms;
                device_cfg_rtsp_port <=> root.device_cfg_rtsp_port;
                device_cfg_rtsp_channel <=> root.device_cfg_rtsp_channel;
                device_cfg_rtsp_profile <=> root.device_cfg_rtsp_profile;
                device_cfg_udp_port <=> root.device_cfg_udp_port;
                device_cfg_udp_expected_id <=> root.device_cfg_udp_expected_id;
                device_cfg_udp_expected_type <=> root.device_cfg_udp_expected_type;
                device_cfg_http_connect_timeout_ms <=> root.device_cfg_http_connect_timeout_ms;
                device_cfg_http_request_timeout_ms <=> root.device_cfg_http_request_timeout_ms;
                device_cfg_http_port <=> root.device_cfg_http_port;
                device_cfg_capture_burst <=> root.device_cfg_capture_burst;
                device_cfg_capture_format <=> root.device_cfg_capture_format;
                refresh_devices => { root.refresh_devices(); }
                select_device(id) => { root.select_device(id); }
                create_device(name) => { root.create_device(name); }
                save_device_name(id, name) => { root.save_device_name(id, name); }
                delete_device(id) => { root.delete_device(id); }
                set_active_device(id) => { root.set_active_device(id); }
                go_live_with_device(id) => { root.go_live_with_device(id); }
            }

            // Media screen — extracted to pages/media_page.slint (Phase 2).
            if root.active_screen == 2 : MediaPage {
                media_rows: root.media_rows;
                media_status: root.media_status;
                media_selected_name: root.media_selected_name;
                media_selected_local_path: root.media_selected_local_path;
                media_selected_has_capture_meta: root.media_selected_has_capture_meta;
                media_download_in_progress: root.media_download_in_progress;
                media_selected_deleted_on_rov: root.media_selected_deleted_on_rov;
                media_preview_image: root.media_preview_image;
                has_media_preview: root.has_media_preview;
                media_selected_is_video: root.media_selected_is_video;
                media_selected_is_image: root.media_selected_is_image;
                media_stream_active: root.media_stream_active;
                media_capture_depth: root.media_capture_depth;
                media_capture_temp: root.media_capture_temp;
                media_capture_heading: root.media_capture_heading;
                media_capture_attitude: root.media_capture_attitude;
                media_capture_coords: root.media_capture_coords;
                media_capture_battery: root.media_capture_battery;
                media_info_subtitle: root.media_info_subtitle;
                media_capture_datetime: root.media_capture_datetime;
                refresh_media => { root.refresh_media(); }
                open_local_media_folder => { root.open_local_media_folder(); }
                select_media(id, name) => { root.select_media(id, name); }
                download_selected_media => { root.download_selected_media(); }
                open_selected_local_media => { root.open_selected_local_media(); }
                delete_selected_media_from_rov => { root.delete_selected_media_from_rov(); }
                stream_selected_media => { root.stream_selected_media(); }
                stop_media_stream => { root.stop_media_stream(); }
                open_with_telemetry => { root.open_with_telemetry(); }
            }

            // Full-bleed live stream screen — extracted to pages/stream_page.slint (Phase 2).
            if root.active_screen == 1 : StreamPage {
                width: parent.width;
                height: parent.height;
                stream_image: root.stream_image;
                has_stream_image: root.has_stream_image;
                stream_is_active: root.stream_is_active;
                has_rov_status: root.has_rov_status;
                rov_listener_running: root.rov_listener_running;
                nmea_gps_running: root.nmea_gps_running;
                nmea_has_fix: root.nmea_has_fix;
                rov_depth_short: root.rov_depth_short;
                rov_temp_short: root.rov_temp_short;
                rov_heading_short: root.rov_heading_short;
                rov_attitude_short: root.rov_attitude_short;
                rov_coords_short: root.rov_coords_short;
                rov_battery_short: root.rov_battery_short;
                active_device_name: root.active_device_name;
                capture_photo => { root.capture_photo(); }
                navigate_profile => { root.navigate_profile(); }
                recalibrate_rov_network => { root.recalibrate_rov_network(); }
            }

            // Full-bleed map screen — extracted to pages/map_page.slint (Phase 2).
            if root.active_screen == 0 : MapPage {
                width: parent.width;
                height: parent.height;
                map_tiles: root.map_tiles;
                nearby_pins: root.nearby_pins;
                map_pin_world_x: root.map_pin_world_x;
                map_pin_world_y: root.map_pin_world_y;
                map_has_pin: root.map_has_pin;
                map_viewport_x <=> root.map_viewport_x;
                map_viewport_y <=> root.map_viewport_y;
                map_viewport_width <=> root.map_viewport_width;
                map_viewport_height <=> root.map_viewport_height;
                pin_lat_lon_short: root.pin_lat_lon_short;
                scale_bar_width: root.scale_bar_width;
                scale_bar_text: root.scale_bar_text;
                nmea_gps_running: root.nmea_gps_running;
                nmea_has_fix: root.nmea_has_fix;
                auth_is_signed_in: root.auth_is_signed_in;
                avatar_text: root.auth_avatar_text;
                map_flicked(a, b, c, d) => { root.map_flicked(a, b, c, d); }
                map_zoom_in(a, b, c, d) => { root.map_zoom_in(a, b, c, d); }
                map_zoom_out(a, b, c, d) => { root.map_zoom_out(a, b, c, d); }
                map_scroll_zoom(a, b, c, d, e) => { root.map_scroll_zoom(a, b, c, d, e); }
                map_pinch_zoom_start => { root.map_pinch_zoom_start(); }
                map_pinch_zoom_update(a, b, c, d, e, f, g) => { root.map_pinch_zoom_update(a, b, c, d, e, f, g); }
                map_pinch_zoom_end => { root.map_pinch_zoom_end(); }
                center_map_on_pin(a, b, c, d) => { root.center_map_on_pin(a, b, c, d); }
                navigate_nmea => { root.navigate_nmea(); }
            }
        }

        top_bar := TopBar {
            x: 0;
            y: 0;
            width: parent.width;
            // Transparent and floating over the Device Map; a solid bar
            // everywhere else.
            overlay: root.active_screen == 0;
            auth_is_signed_in: root.auth_is_signed_in;
            avatar_text: root.auth_avatar_text;
            active_screen: root.active_screen;
            navigate_profile => { root.navigate_profile(); }
            navigate_map => { root.navigate_map(content_panel.width, content_panel.height); }
            navigate_stream => { root.navigate_stream(); }
            navigate_media => { root.navigate_media(); }
            navigate_nmea => { root.navigate_nmea(); }
        }
    }
}
