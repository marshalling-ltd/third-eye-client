# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Local build script artifacts
ffmpeg-arm64/
ffmpeg-arm64.zip
ffmpeg-x86_64/
ffmpeg-x86_64.zip

# Local coverage output (cargo llvm-cov)
lcov.info
*.profraw

# mediamtx auto-generated TLS files (chasing-simulator)
auto.crt
auto.key
